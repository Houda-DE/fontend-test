{
  "name": "recruitment-pipeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "json-server --watch db.json --port 3000",
    "api:reset": "cp db.backup.json db.json",
    "start": "concurrently -n api,web -c magenta,cyan \"npm:api\" \"npm:dev\"",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b --force",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live-api.integration.test.ts"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.0.0",
    "jsdom": "^26.0.0",
    "json-server": "^0.17.4",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
